<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 4-Point Base Spacing Scale (4, 8, 12, 16, 20, 24, 32, 40, 48, 64) -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space40">40</sys:Double>
    <sys:Double x:Key="Space48">48</sys:Double>
    <sys:Double x:Key="Space64">64</sys:Double>

    <!-- Semantic Layout & Component Spacing Tokens -->
    <GridLength x:Key="SidebarWidth">224</GridLength>
    <sys:Double x:Key="ContentMaxWidth">1440</sys:Double>
    <Thickness x:Key="PageGutter">32,24,32,32</Thickness>
    <Thickness x:Key="SidebarPadding">20,24,20,20</Thickness>
    <Thickness x:Key="HeroInset">32,28,32,32</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="SectionGapLarge">0,0,0,32</Thickness>
    <Thickness x:Key="HeaderGap">0,0,0,20</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">16</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <Thickness x:Key="NavItemMargin">12,2</Thickness>
    <Thickness x:Key="NavItemPadding">12,0</Thickness>
    <Thickness x:Key="ButtonPaddingPrimary">24,0</Thickness>
    <Thickness x:Key="ButtonPaddingStandard">16,0</Thickness>
    <Thickness x:Key="ButtonPaddingCompact">12,0</Thickness>
    <Thickness x:Key="BadgePadding">10,4</Thickness>

    <sys:Double x:Key="ButtonHeightPrimary">44</sys:Double>
    <sys:Double x:Key="ButtonHeightStandard">36</sys:Double>
    <sys:Double x:Key="ButtonHeightCompact">32</sys:Double>
    <sys:Double x:Key="InputHeight">36</sys:Double>

    <CornerRadius x:Key="RadiusHero">16</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusGameCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusThumbnail">12</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusInput">8</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">6</CornerRadius>

    <!-- AMD Radeon Black & Charcoal Surface Scale -->
    <Color x:Key="SurfaceCanvasColor">#101010</Color>
    <Color x:Key="SurfaceSidebarColor">#141414</Color>
    <Color x:Key="SurfaceCardColor">#181818</Color>
    <Color x:Key="SurfaceSecondaryColor">#202020</Color>
    <Color x:Key="SurfaceElevatedColor">#292929</Color>
    <Color x:Key="SurfaceInputColor">#121212</Color>

    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource SurfaceCanvasColor}" />
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="{StaticResource SurfaceSidebarColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
    <SolidColorBrush x:Key="SurfaceWellBrush" Color="#141414" />

    <!-- Subtle Charcoal Borders -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#242424" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#202020" />
    <SolidColorBrush x:Key="BorderEmphasisBrush" Color="#333333" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="#ED1C24" />

    <!-- Text Hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#828282" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5C5C5C" />

    <!-- AMD Radeon Brand Red & Semantic Status Palette -->
    <SolidColorBrush x:Key="AccentOpticalBrush" Color="#ED1C24" />
    <SolidColorBrush x:Key="AccentOpticalHoverBrush" Color="#FF343B" />
    <SolidColorBrush x:Key="AccentOpticalPressedBrush" Color="#C8141B" />
    <SolidColorBrush x:Key="AccentOpticalSubtleBrush" Color="#1FED1C24" />

    <SolidColorBrush x:Key="StatusSupportedBrush" Color="#55C78A" />
    <SolidColorBrush x:Key="StatusSupportedBgBrush" Color="#112419" />
    <SolidColorBrush x:Key="StatusExperimentalBrush" Color="#E7B45B" />
    <SolidColorBrush x:Key="StatusExperimentalBgBrush" Color="#292010" />
    <SolidColorBrush x:Key="StatusDependencyBrush" Color="#E7B45B" />
    <SolidColorBrush x:Key="StatusDependencyBgBrush" Color="#292010" />
    <SolidColorBrush x:Key="StatusUnsupportedBrush" Color="#EA6666" />
    <SolidColorBrush x:Key="StatusUnsupportedBgBrush" Color="#2B1414" />

    <!-- Atmospheric Hero & Cover Scrims (Neutral dark gradient preserving vivid right artwork) -->
    <LinearGradientBrush x:Key="HeroVignetteHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EB101010" Offset="0.0" />
        <GradientStop Color="#BA101010" Offset="0.38" />
        <GradientStop Color="#30101010" Offset="0.68" />
        <GradientStop Color="#00101010" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroVignetteVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14101010" Offset="0.0" />
        <GradientStop Color="#28101010" Offset="0.52" />
        <GradientStop Color="#D6101010" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00101010" Offset="0.0" />
        <GradientStop Color="#99101010" Offset="0.56" />
        <GradientStop Color="#F0101010" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThumbnailBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20101010" Offset="0.0" />
        <GradientStop Color="#59101010" Offset="0.5" />
        <GradientStop Color="#CC101010" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Official Bundled Typography (Google Sans + Space Mono) -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/ProjectLuma.UI;component/Assets/Fonts/#Google Sans, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontUi">pack://application:,,,/ProjectLuma.UI;component/Assets/Fonts/#Google Sans, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/ProjectLuma.UI;component/Assets/Fonts/#Space Mono, Consolas, Courier New</FontFamily>

    <!-- Focus Visual -->
    <Style x:Key="LumaFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{StaticResource AccentOpticalBrush}" StrokeThickness="1.5" RadiusX="8" RadiusY="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LumaCardFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{StaticResource AccentOpticalBrush}" StrokeThickness="1.5" RadiusX="12" RadiusY="12" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevated Surface Panel -->
    <Style x:Key="LumaCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Primary AMD Red CTA -->
    <Style x:Key="LumaPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentOpticalBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingStandard}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentOpticalHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentOpticalPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#252525" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Charcoal Button -->
    <Style x:Key="LumaSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderEmphasisBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingStandard}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#484848" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#161616" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#161616" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#242424" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet Translucent Ghost / Icon Button -->
    <Style x:Key="LumaGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightCompact}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingCompact}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive / Restore Button -->
    <Style x:Key="LumaDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LumaSecondaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource StatusUnsupportedBgBrush}" />
        <Setter Property="Foreground" Value="#F28B8B" />
        <Setter Property="BorderBrush" Value="#5C2323" />
    </Style>

    <!-- Filter Pill Radio Button -->
    <Style x:Key="LumaFilterPillStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightCompact}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A1113" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset Search / TextBox (zero vertical clipping) -->
    <Style x:Key="LumaTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentOpticalBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusInput}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Charcoal Toggle Switch with AMD Red Active State -->
    <Style x:Key="LumaToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Grid.Column="0" Width="40" Height="22" CornerRadius="11" Background="#252525" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#9A9A9A" HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2A1113" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentOpticalBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="#161616" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#242424" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#444444" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark Charcoal ComboBox -->
    <Style x:Key="LumaComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderEmphasisBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusInput}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#B8B8B8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,28,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="240"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource BorderEmphasisBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusInput}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#333333" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A1113" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim Dark Obsidian ScrollBar Style -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="7" />
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" Background="#343434" CornerRadius="3.5" Margin="1,2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="#585858" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="#ED1C24" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="MinHeight" Value="7" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
