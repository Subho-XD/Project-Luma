<UserControl x:Class="ProjectLuma.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource PageGutter}" HorizontalAlignment="Stretch" SizeChanged="OnHomeContainerSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Quiet Top Utility Bar (Matching Reference Top Strip) -->
            <Grid Grid.Row="0" Margin="{StaticResource HeaderGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="HomeTopTabs" Content="Featured"
                                 Command="{Binding SelectHomeFilterCommand}" CommandParameter="Featured"
                                 Margin="0,0,24,0" Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}" Mode="OneWay">
                                <Binding Source="Featured" />
                                <Binding Path="HomeFilterMode" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel>
                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextTertiaryBrush}" Padding="0,4" />
                                    <Border x:Name="Underline" Height="2" Background="{StaticResource AccentOpticalBrush}" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton GroupName="HomeTopTabs" Content="Ready to enhance"
                                 Command="{Binding SelectHomeFilterCommand}" CommandParameter="Ready"
                                 Margin="0,0,24,0" Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}" Mode="OneWay">
                                <Binding Source="Ready" />
                                <Binding Path="HomeFilterMode" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel>
                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextTertiaryBrush}" Padding="0,4" />
                                    <Border x:Name="Underline" Height="2" Background="{StaticResource AccentOpticalBrush}" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton GroupName="HomeTopTabs" Content="Enhanced"
                                 Command="{Binding SelectHomeFilterCommand}" CommandParameter="Enhanced"
                                 Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}" Mode="OneWay">
                                <Binding Source="Enhanced" />
                                <Binding Path="HomeFilterMode" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel>
                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextTertiaryBrush}" Padding="0,4" />
                                    <Border x:Name="Underline" Height="2" Background="{StaticResource AccentOpticalBrush}" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LumaGhostButtonStyle}" Command="{Binding RescanLibrariesCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Rescan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LumaGhostButtonStyle}" Command="{Binding AddGameManuallyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Add Game" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Empty State when no games detected -->
            <Border Grid.Row="1" Style="{StaticResource LumaCardStyle}" Margin="{StaticResource SectionGapLarge}" Padding="40"
                    Visibility="{Binding FeaturedGame, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="Welcome to Project Luma" FontFamily="{StaticResource FontDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a game executable or scan your Steam, Epic, GOG, Ubisoft, EA, Battle.net, or Xbox libraries to populate your Home Game Hub."
                               FontFamily="{StaticResource FontUi}" FontSize="14" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Rescan Libraries" Style="{StaticResource LumaPrimaryButtonStyle}" Command="{Binding RescanLibrariesCommand}" Margin="0,0,12,0" />
                        <Button Content="Add Game" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding AddGameManuallyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 1: Dominant Cinematic Hero Banner (Sole Visual Reference Proportions) -->
            <Border x:Name="HeroBannerContainer" Grid.Row="1" Height="420" CornerRadius="{StaticResource RadiusHero}"
                    BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1"
                    ClipToBounds="True" Margin="{StaticResource SectionGap}"
                    Visibility="{Binding FeaturedGame, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <!-- Full-bleed high-resolution panoramic game artwork -->
                    <Image Source="{Binding FeaturedGame.HeroImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=1600}"
                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Rectangle Fill="{StaticResource HeroVignetteHorizontalBrush}" />
                    <Rectangle Fill="{StaticResource HeroVignetteVerticalBrush}" />

                    <!-- Top-left Platform Mark & Top-right Status Pill -->
                    <Grid Margin="{StaticResource HeroInset}" VerticalAlignment="Top">
                        <Border HorizontalAlignment="Left" Background="#99101010" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="{StaticResource RadiusBadge}" Padding="10,4">
                            <TextBlock Text="{Binding FeaturedGame.LauncherBadge}" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <Border HorizontalAlignment="Right" CornerRadius="{StaticResource RadiusBadge}" Padding="{StaticResource BadgePadding}" BorderThickness="1"
                                Background="{Binding FeaturedGame.FriendlyStatus, Converter={StaticResource FriendlyStatusBrushConverter}, ConverterParameter=bg}"
                                BorderBrush="{Binding FeaturedGame.FriendlyStatus, Converter={StaticResource FriendlyStatusBrushConverter}}">
                            <TextBlock Text="{Binding FeaturedGame.FriendlyStatusText}" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding FeaturedGame.FriendlyStatus, Converter={StaticResource FriendlyStatusBrushConverter}}" />
                        </Border>
                    </Grid>

                    <!-- Bottom-left Game Identity, Tagline & Prominent Action Cluster -->
                    <Grid Margin="{StaticResource HeroInset}" VerticalAlignment="Bottom">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <!-- Game Logo (or Bold Display Title) -->
                            <Image Source="{Binding FeaturedGame.LogoImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=560}"
                                   Visibility="{Binding FeaturedGame.HasLogoImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                   MaxHeight="88" MaxWidth="420" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding FeaturedGame.Title}"
                                       Visibility="{Binding FeaturedGame.HasLogoImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                       FontFamily="{StaticResource FontDisplay}" FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                            <!-- Small Readiness Chip (parallels reference '90% recommended') -->
                            <Border HorizontalAlignment="Left" Background="#B8161616" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusBadge}" Padding="10,4" Margin="0,0,0,12">
                                <TextBlock Text="{Binding GpuInfo.ModelName, StringFormat=Tailored for {0}}"
                                           FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>

                            <!-- Concise Game Enhancement Description -->
                            <TextBlock Text="{Binding FeaturedGame.RecommendationSummary}"
                                       FontFamily="{StaticResource FontUi}" FontSize="15" LineHeight="22" Foreground="#EAEAEA"
                                       TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,0,0,20" />

                            <!-- Primary Action Cluster: Bold Red Play + Secondary Enhance + Quiet Profile Context -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource LumaPrimaryButtonStyle}"
                                        Height="{StaticResource ButtonHeightPrimary}" MinWidth="152" Padding="24,0"
                                        Command="{Binding PlayGameCommand}" CommandParameter="{Binding FeaturedGame}"
                                        Margin="0,0,12,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding FeaturedGame.PlayButtonLabel}" FontFamily="{StaticResource FontUi}" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentOpticalHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentOpticalPressedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="Enhance" Style="{StaticResource LumaSecondaryButtonStyle}"
                                        Height="{StaticResource ButtonHeightPrimary}" MinWidth="124" Padding="20,0"
                                        Background="#B81C1C1C" BorderBrush="#44FFFFFF" FontSize="14" FontWeight="SemiBold"
                                        Command="{Binding EnhanceGameFromHomeCommand}" CommandParameter="{Binding FeaturedGame}"
                                        Margin="0,0,16,0" />

                                <Button Style="{StaticResource LumaGhostButtonStyle}" Height="36" Padding="12,0"
                                        Command="{Binding OpenGameDetailsCommand}" CommandParameter="{Binding FeaturedGame}">
                                    <TextBlock FontFamily="{StaticResource FontUi}" FontSize="13" FontWeight="Medium" Foreground="#D4D4D4">
                                        <Run Text="{Binding FeaturedGame.Profile.SelectedPreset, Mode=OneWay}" /><Run Text=" profile  " /><Run Text="Configure" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Horizontal Game Thumbnail Gallery Strip ("Resume my games") -->
            <StackPanel Grid.Row="2" Margin="{StaticResource SectionGap}"
                        Visibility="{Binding HomeStripGames.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="Resume my games" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HomeStripGames.Count}" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource LumaGhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding NavigateCommand}" CommandParameter="MyGames">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Explore all" FontFamily="{StaticResource FontUi}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Path Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 4-Column Equal-Edge Landscape Thumbnail Strip (Negative right margin cancels trailing item gutter for exact Hero edge parity) -->
                <ItemsControl ItemsSource="{Binding HomeStripGames}" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ThumbRoot" Margin="0,0,16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 16:9 Landscape Thumbnail Frame (Clicking selects Featured Game in Hero) -->
                                <Button Grid.Row="0" Command="{Binding DataContext.SelectFeaturedGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                        FocusVisualStyle="{StaticResource LumaFocusVisual}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ThumbBorder" Height="{Binding ThumbHeight, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=156}"
                                                    CornerRadius="{StaticResource RadiusThumbnail}"
                                                    Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderHairlineBrush}"
                                                    BorderThickness="1.5" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding HeroImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=640}"
                                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Rectangle Fill="{StaticResource ThumbnailBottomScrimBrush}" />

                                                    <!-- Real Game Logo centered inside landscape frame -->
                                                    <Image Source="{Binding LogoImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=320}"
                                                           Visibility="{Binding HasLogoImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           MaxHeight="52" MaxWidth="168" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />

                                                    <!-- Subtle Platform Chip top-left -->
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#A6101010" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                        <TextBlock Text="{Binding LauncherBadge}" FontFamily="{StaticResource FontUi}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#7A7A7A" />
                                                </Trigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource ObjectReferenceEqualsMultiConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.FeaturedGame" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                                                    <Setter TargetName="ThumbBorder" Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Minimal Title, Quick Play, Details & Quiet Status Subtitle Below Thumbnail -->
                                <Grid Grid.Row="1" Margin="4,10,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontFamily="{StaticResource FontUi}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Title}" />

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="28" Height="28" Padding="0" Style="{StaticResource LumaGhostButtonStyle}"
                                                ToolTip="Launch game"
                                                Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconPlay}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>
                                        <Button Width="28" Height="28" Padding="0" Style="{StaticResource LumaGhostButtonStyle}"
                                                ToolTip="Open Game Details"
                                                Command="{Binding DataContext.OpenGameDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconMore}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FriendlyStatusText}"
                                               FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Row 3: Compact Gaming Information Strip (Aligned strictly to Hero & Thumbnail Edges) -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}" Padding="20,16"
                    Visibility="{Binding FeaturedGame, Converter={StaticResource BoolToVisibilityConverter}}">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Profile" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding FeaturedGame.Profile.SelectedPreset}" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Image Quality" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding FeaturedGame.Profile.SharperImageStatusText}" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Gameplay Smoothness" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding FeaturedGame.Profile.SmootherGameplayStatusText}" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="AI Visuals" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding FeaturedGame.Profile.AiVisualStatusText}" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>