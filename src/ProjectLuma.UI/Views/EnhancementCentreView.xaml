<UserControl x:Class="ProjectLuma.UI.Views.EnhancementCentreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource PageGutter}">
            <!-- Clean Page Header -->
            <Grid Margin="{StaticResource HeaderGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Enhancement Library" FontFamily="{StaticResource FontDisplay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding GpuInfo.ModelName, StringFormat='Discover, install, and verify compatible graphics components for your {0}.'}"
                               FontFamily="{StaticResource FontUi}" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Scan PC &amp; Downloads" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ScanGameLibrariesForDllsCommand}" Margin="0,0,12,0" />
                    <Button Content="Open Home" Style="{StaticResource LumaPrimaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                </StackPanel>
            </Grid>

            <!-- 4 Enhancement Categories + All Filter Strip -->
            <ItemsControl ItemsSource="{Binding EnhancementCategoryTabs}" Margin="{StaticResource SectionGap}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource LumaFilterPillStyle}"
                                     Content="{Binding}"
                                     GroupName="EnhancementCategories"
                                     Command="{Binding DataContext.SelectEnhancementCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="DataContext.SelectedEnhancementCategory" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Authorized Enhancement Component Catalog (Directly visible, never hidden in an Expander) -->
            <ItemsControl ItemsSource="{Binding FilteredComponentItems}" Margin="{StaticResource SectionGap}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LumaCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Background="{Binding InstallState, Converter={StaticResource ComponentStateBrushConverter}, ConverterParameter=bg}"
                                                    BorderBrush="{Binding InstallState, Converter={StaticResource ComponentStateBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="{StaticResource RadiusBadge}" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock AutomationProperties.AutomationId="{Binding Id, StringFormat=ComponentStatus_{0}}"
                                                           Text="{Binding InstallStateLabel}" FontFamily="{StaticResource FontUi}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding InstallState, Converter={StaticResource ComponentStateBrushConverter}}" />
                                            </Border>
                                            <Border Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusBadge}" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryDisplayName}" FontFamily="{StaticResource FontUi}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding FriendlyDescription}" FontFamily="{StaticResource FontUi}" FontSize="13" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusDetailText}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding SupportedGamesSummary, StringFormat=Games: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding GpuSupportSummary, StringFormat=AMD GPUs: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,16,0" />
                                            <TextBlock AutomationProperties.AutomationId="{Binding Id, StringFormat=ComponentVersion_{0}}"
                                                       Text="{Binding CurrentInstalledVersion, StringFormat=Version: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <!-- Automatic Authorized Install / Update / Retry (NEVER rendered for incompatible or restricted components) -->
                                            <Button Content="{Binding ActionButtonLabel}" Style="{StaticResource LumaPrimaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="16,0" Margin="0,0,8,0"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding DataContext.DownloadBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />

                                            <!-- Restricted upstream guidance when NOT installed yet -->
                                            <Button Content="Official Release" Style="{StaticResource LumaSecondaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="12,0" Margin="0,0,8,0"
                                                    Visibility="{Binding ShowExternalAcquireButtons, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.DownloadBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Locate Local Copy" Style="{StaticResource LumaSecondaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="12,0" Margin="0,0,8,0"
                                                    Visibility="{Binding ShowExternalAcquireButtons, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.ConnectLocalBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />

                                            <!-- Verified external NeuralHub v0.9.0 controls (no duplicate reinstall prompts) -->
                                            <Button AutomationProperties.AutomationId="NeuralHubOpenBtn" Content="Open NeuralHub" Style="{StaticResource LumaPrimaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="12,0" Margin="0,0,8,0"
                                                    Visibility="{Binding IsExternalNeuralHubInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.LaunchNeuralHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button AutomationProperties.AutomationId="NeuralHubVerifyBtn" Content="Verify Installation" Style="{StaticResource LumaSecondaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="12,0" Margin="0,0,8,0"
                                                    Visibility="{Binding IsExternalNeuralHubInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.VerifyNeuralHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                            <!-- Driver-managed guidance (AFMF 2.1) -->
                                            <Button Content="Configure in Adrenalin" Style="{StaticResource LumaSecondaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="14,0" Margin="0,0,8,0"
                                                    Visibility="{Binding IsDriverManaged, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.OpenExternalUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding OfficialReleasesPageUrl}" />

                                            <Button Content="View details" Style="{StaticResource LumaGhostButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="10,0"
                                                    Command="{Binding DataContext.ToggleComponentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsHardwareIncompatible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                            <Button Content="Cancel" Style="{StaticResource LumaDangerButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.CancelBackendDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button AutomationProperties.AutomationId="NeuralHubConfigureGameBtn" Content="Configure Game" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                                    Visibility="{Binding IsExternalNeuralHubInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.ConfigureNeuralHubGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button AutomationProperties.AutomationId="NeuralHubDiagnosticsBtn" Content="View Diagnostics" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" Padding="10,0"
                                                    Visibility="{Binding IsExternalNeuralHubInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.ToggleNeuralDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button Content="Verify" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                                    Visibility="{Binding ShowInternalVerifyRepair, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.VerifyBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Repair" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                                    Visibility="{Binding ShowInternalVerifyRepair, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RepairBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Remove" Style="{StaticResource LumaDangerButtonStyle}" Height="28" Padding="10,0"
                                                    Visibility="{Binding ShowInternalRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RemoveBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Streaming Download Progress -->
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding StatusDetailText}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DownloadedSizeText}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding DownloadSpeedText}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource AccentOpticalBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding DownloadProgressPercent}" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource AccentOpticalBrush}" Background="{StaticResource SurfaceInputBrush}" BorderThickness="0" />
                                </StackPanel>

                                <!-- Actionable Error Banner -->
                                <Border Visibility="{Binding LastErrorText, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{StaticResource StatusUnsupportedBgBrush}" BorderBrush="{StaticResource StatusUnsupportedBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="12" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding LastErrorText}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="#F28B8B" TextWrapping="Wrap" />
                                </Border>

                                <!-- Expanded Technical Details (Raw DLL filenames only inside View Details) -->
                                <Border Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{StaticResource SurfaceWellBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LicenseSpdx, StringFormat=License: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding MissingDependenciesSummary, StringFormat=Dependencies: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding AdvancedFilesSummary, StringFormat=Component files: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding CompatibilityStatus}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel Orientation="Horizontal" Visibility="{Binding IsHardwareIncompatible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                            <Button Content="Import Official Archive" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" FontSize="12" Padding="12,0" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ImportLocalBackendArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Rollback Previous" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" FontSize="12" Padding="12,0"
                                                    Command="{Binding DataContext.RollbackBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </WrapPanel>

                                        <!-- Dedicated NVIDIA Neural Rendering Model section (strictly distinct from Official Archive import) -->
                                        <Border Visibility="{Binding IsNeuralRenderingComponent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="16" Margin="0,12,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <TextBlock Text="NVIDIA Neural Rendering Model" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="Select a legitimate NVIDIA Neural Rendering DLL that you are authorized to use. Project Luma will validate the file and check whether it is compatible with your selected Neural Rendering model."
                                                                   FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <TextBlock Text="Target Model" FontFamily="{StaticResource FontUi}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                                                        <ComboBox Style="{StaticResource LumaComboBoxStyle}" Width="120"
                                                                  ItemsSource="{Binding DataContext.AvailableNeuralModels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding DataContext.SelectedNeuralImportModel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding DataContext.NeuralRequiredDllName, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Required DLL: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding DataContext.NeuralRequiredModelDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Model Type: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding DataContext.NeuralMinimumVersionRequired, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Minimum Version: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding DataContext.NeuralDetectedVersion, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Detected Version: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding DataContext.NeuralImportStatusText, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Import Status: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding DataContext.NeuralValidationStatusText, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Validation Status: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource StatusExperimentalBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding DataContext.NeuralLocalInstallationStatusText, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Local Installation: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding DataContext.NeuralValidationDetailText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Visibility="{Binding DataContext.NeuralValidationDetailText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           FontFamily="{StaticResource FontUi}" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Content="Import NVIDIA DLL" Style="{StaticResource LumaPrimaryButtonStyle}" Height="30" FontSize="12" Padding="14,0" Margin="0,0,8,8"
                                                            Command="{Binding DataContext.ImportNvidiaDllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Scan Installed Games" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            Command="{Binding DataContext.ScanGamesForNeuralDllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Scan Downloads" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            Command="{Binding DataContext.ScanDownloadsForNeuralDllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Open DLL Vault" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            Command="{Binding DataContext.OpenDllVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Verify Imported DLL" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            IsEnabled="{Binding DataContext.HasImportedNeuralDll, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.VerifyImportedNeuralDllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Remove Imported Copy" Style="{StaticResource LumaDangerButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            IsEnabled="{Binding DataContext.HasImportedNeuralDll, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.RemoveImportedNeuralDllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Cancel Scan" Style="{StaticResource LumaDangerButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            Visibility="{Binding DataContext.IsNeuralCandidateScanBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.CancelNeuralScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Open NeuralHub" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            Visibility="{Binding DataContext.IsNeuralHubDetected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.LaunchNeuralHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="Verify Installation" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,8,8"
                                                            Visibility="{Binding DataContext.IsNeuralHubDetected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.VerifyNeuralHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Content="View Diagnostics" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="12,0" Margin="0,0,0,8"
                                                            Visibility="{Binding DataContext.IsNeuralHubDetected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.ToggleNeuralDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding DataContext.NeuralCandidateScanSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Visibility="{Binding DataContext.NeuralCandidateScanSummary, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                <!-- Per-game NeuralHub Integration & OptiScaler Conflict Inspection -->
                                                <ItemsControl ItemsSource="{Binding DataContext.NeuralHubGames, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SurfaceWellBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="10" Margin="0,4,0,0">
                                                                <StackPanel>
                                                                    <WrapPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding GameName}" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                                                        <TextBlock Text="{Binding ExpectedProxyDll, StringFormat=Proxy: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding StatusSummary}" FontFamily="{StaticResource FontUi}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding ConflictDetail}" Visibility="{Binding HasOptiScalerProxyConflict, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                               FontFamily="{StaticResource FontUi}" FontSize="11.5" Foreground="{StaticResource StatusExperimentalBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Collapsible Read-Only 7-State Diagnostics -->
                                                <Border Visibility="{Binding DataContext.IsNeuralDiagnosticsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="{StaticResource SurfaceWellBrush}" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="12" Margin="0,4,0,8">
                                                    <TextBox AutomationProperties.AutomationId="NeuralHubDiagnosticsText"
                                                             Text="{Binding DataContext.NeuralHubDiagnosticsText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                             IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                                             FontFamily="{StaticResource FontMono}" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" />
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding DataContext.DiscoveredNeuralCandidates, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SurfaceWellBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="10" Margin="0,4,0,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding DisplaySummary}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding SourcePath}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="Use This File" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" FontSize="11.5" Padding="10,0"
                                                                            IsEnabled="{Binding CanImport}"
                                                                            Command="{Binding DataContext.UseDiscoveredNeuralCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Collapsible Local User-Owned Component Vault (Advanced) -->
            <Expander Header="Local component files (advanced)" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" IsExpanded="False">
                <Border Style="{StaticResource LumaCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Local user-owned rendering components" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Automatically discovers compatible local components across registered game folders and Downloads, or lets you verify a local DLL file."
                                           FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Scan PC &amp; Downloads" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ScanGameLibrariesForDllsCommand}" Margin="0,0,8,0" />
                                <Button Content="Locate File" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ImportUserDllCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="No user-owned NGX DLL files verified in local vault yet."
                                   Visibility="{Binding UserDlls.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                   FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}" />

                        <ItemsControl ItemsSource="{Binding UserDlls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileVersion}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource AccentOpticalBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Sha256}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Grid.Column="3" Content="Remove" Style="{StaticResource LumaDangerButtonStyle}" Height="28" Padding="10,0"
                                                    Command="{Binding DataContext.DeleteUserDllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding FileName}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>