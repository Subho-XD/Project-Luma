<UserControl x:Class="ProjectLuma.UI.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProjectLuma.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource PageGutter}">
            <!-- Empty Selection Fallback -->
            <Border Style="{StaticResource LumaCardStyle}"
                    Visibility="{Binding SelectedGame, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Choose a Game Hub" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Select any game from Home or My Games to view and manage its enhancement settings." FontFamily="{StaticResource FontUi}" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,20" />
                    <Button Content="Open My Games" Style="{StaticResource LumaPrimaryButtonStyle}" Command="{Binding BackToGamesCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Dedicated Game Hub derived directly from Home Design Language -->
            <StackPanel Visibility="{Binding SelectedGame, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Section 1: Cinematic Game Hub Hero -->
                <Border Height="340" CornerRadius="{StaticResource RadiusHero}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" ClipToBounds="True" Margin="{StaticResource SectionGap}">
                    <Grid>
                        <Image Source="{Binding SelectedGame.HeroImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=1600}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Rectangle Fill="{StaticResource HeroVignetteHorizontalBrush}" />
                        <Rectangle Fill="{StaticResource HeroVignetteVerticalBrush}" />

                        <!-- Top Utility Strip Over Hero -->
                        <Grid Margin="{StaticResource HeroInset}" VerticalAlignment="Top">
                            <Button Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" Padding="12,0" Background="#B8141414"
                                    Command="{Binding BackToGamesCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="My Games" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Change Cover" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" Padding="12,0" Background="#B8141414"
                                        Command="{Binding ChangeCoverArtworkCommand}" Margin="0,0,8,0" />
                                <Button Content="Change Hero" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" Padding="12,0" Background="#B8141414"
                                        Command="{Binding ChangeHeroArtworkCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Bottom Game Identity, Profile Selector & Play / Enhance Actions -->
                        <Grid Margin="{StaticResource HeroInset}" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#99101010" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="{StaticResource RadiusBadge}" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedGame.LauncherBadge}" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="{StaticResource RadiusBadge}" Padding="{StaticResource BadgePadding}" BorderThickness="1"
                                            Background="{Binding SelectedGame.FriendlyStatus, Converter={StaticResource FriendlyStatusBrushConverter}, ConverterParameter=bg}"
                                            BorderBrush="{Binding SelectedGame.FriendlyStatus, Converter={StaticResource FriendlyStatusBrushConverter}}">
                                        <TextBlock Text="{Binding SelectedGame.FriendlyStatusText}" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding SelectedGame.FriendlyStatus, Converter={StaticResource FriendlyStatusBrushConverter}}" />
                                    </Border>
                                </StackPanel>

                                <Image Source="{Binding SelectedGame.LogoImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=560}"
                                       Visibility="{Binding SelectedGame.HasLogoImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                       MaxHeight="76" MaxWidth="380" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding SelectedGame.Title}"
                                           Visibility="{Binding SelectedGame.HasLogoImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                <TextBlock Text="Enhancement Profile" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="Balanced" Margin="0,0,8,4" Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="#BF181818" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                                                                <TextBlock x:Name="Txt" Text="Balanced" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.Profile.SelectedPreset}" Value="Balanced">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#2A1113" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="VisualQuality" Margin="0,0,8,4" Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="#BF181818" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                                                                <TextBlock x:Name="Txt" Text="Visual Quality" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.Profile.SelectedPreset}" Value="VisualQuality">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#2A1113" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="SmootherGameplay" Margin="0,0,8,4" Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="#BF181818" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                                                                <TextBlock x:Name="Txt" Text="Smoother Gameplay" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.Profile.SelectedPreset}" Value="SmootherGameplay">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#2A1113" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SelectPresetCommand}" CommandParameter="Custom" Margin="0,0,0,4" Cursor="Hand" FocusVisualStyle="{StaticResource LumaFocusVisual}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="#BF181818" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                                                                <TextBlock x:Name="Txt" Text="Custom" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.Profile.SelectedPreset}" Value="Custom">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#2A1113" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOpticalBrush}" />
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Primary Game Actions: Play + Enhance -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Button Style="{StaticResource LumaPrimaryButtonStyle}" Height="{StaticResource ButtonHeightPrimary}" Padding="28,0" Margin="0,0,12,0"
                                        Command="{Binding PlayGameCommand}" CommandParameter="{Binding SelectedGame}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding SelectedGame.PlayButtonLabel}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LumaSecondaryButtonStyle}" Height="{StaticResource ButtonHeightPrimary}" Padding="20,0" Background="#CC1E1E1E" BorderBrush="#44FFFFFF"
                                        Content="Enhance" FontSize="14" FontWeight="SemiBold"
                                        Command="{Binding ApplyRecommendedSetupCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Anti-Cheat Protection Notice -->
                <Border Visibility="{Binding SelectedGame.HasAntiCheatWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource StatusUnsupportedBgBrush}" BorderBrush="{StaticResource StatusUnsupportedBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}" Margin="{StaticResource SectionGap}">
                    <StackPanel>
                        <TextBlock Text="Online Protection Detected" FontFamily="{StaticResource FontDisplay}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource StatusUnsupportedBrush}" />
                        <TextBlock Text="This game uses anti-cheat software. To protect your account, Project Luma keeps game files untouched unless an official offline single-player mode is confirmed." FontFamily="{StaticResource FontUi}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" Margin="0,12,0,0"
                                  IsChecked="{Binding SelectedGame.OfflineAntiCheatConfirmed}"
                                  Content="I am playing strictly offline with anti-cheat turned off" />
                    </StackPanel>
                </Border>

                <!-- Sibling Optional Component Attention Banner (Flat, NEVER nested inside another card) -->
                <Border Visibility="{Binding SelectedGameComponents.RequiresUserAttention, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource StatusExperimentalBgBrush}" BorderBrush="{StaticResource StatusExperimentalBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}" Margin="{StaticResource SectionGap}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Optional setup required for AI Visuals" FontFamily="{StaticResource FontDisplay}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource StatusExperimentalBrush}" />
                            <TextBlock Text="{Binding SelectedGameComponents.SummaryBanner}" FontFamily="{StaticResource FontUi}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding SelectedGameComponents.Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" Visibility="{Binding IsSatisfied, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FriendlyName}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Grid.Column="1" Content="Set up" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" FontSize="11.5" Padding="12,0"
                                                    Command="{Binding DataContext.LocateComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Auto-Scan PC" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" Margin="0,0,0,8"
                                    Command="{Binding AutoDiscoverNowCommand}" />
                            <Button Content="Enhancement Library" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32"
                                    Command="{Binding OpenNeuralSetupCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 2: Clean 2-Column Hub Content aligned strictly to Hero edges -->
                <Grid Margin="{StaticResource SectionGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: 4-Row Game Enhancements -->
                    <Border Grid.Column="0" Style="{StaticResource LumaCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Game enhancements" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <!-- 1. AI Visuals (Always surfaces real reason when toggle unavailable) -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="AI Visuals" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Enhances visual details, materials and lighting using compatible neural-rendering technology." FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:CapabilityBadge State="{Binding SelectedGame.NeuralState}" Label="{Binding SelectedGame.Profile.AiVisualStatusText}" Margin="0,0,12,0" />
                                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsEnabled="{Binding SelectedGame.CanToggleNeural}" IsChecked="{Binding SelectedGame.EnableNeuralRendering}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SelectedGame.NeuralUnavailableReason}"
                                           Visibility="{Binding SelectedGame.NeuralUnavailableReason, Converter={StaticResource BoolToVisibilityConverter}}"
                                           FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource StatusExperimentalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedGame.ShowFindRequiredComponents, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Find Required Components" Style="{StaticResource LumaSecondaryButtonStyle}" Height="30" FontSize="12" Padding="14,0"
                                            Command="{Binding FindRequiredComponentsCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                                <!-- 2. Image Quality -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Image Quality" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Improves image reconstruction and clarity." FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:CapabilityBadge State="{Binding SelectedGame.SuperResState}" Label="{Binding SelectedGame.Profile.SharperImageStatusText}" Margin="0,0,12,0" />
                                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsEnabled="{Binding SelectedGame.CanToggleSuperRes}" IsChecked="{Binding SelectedGame.EnableSuperResolution}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                                <!-- 3. Gameplay Smoothness -->
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Gameplay Smoothness" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Uses compatible frame-generation technologies." FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:CapabilityBadge State="{Binding SelectedGame.FrameGenBadgeState}" Label="{Binding SelectedGame.Profile.SmootherGameplayStatusText}" Margin="0,0,12,0" />
                                            <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsEnabled="{Binding SelectedGame.CanToggleFrameGen}" IsChecked="{Binding SelectedGame.EnableFrameGeneration}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedGame.FrameGenUnavailableReason}"
                                               Visibility="{Binding SelectedGame.FrameGenUnavailableReason, Converter={StaticResource BoolToVisibilityConverter}}"
                                               FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource StatusExperimentalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <!-- 4. Ray-Traced Effects -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Ray-Traced Effects" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Improves compatible ray-traced reconstruction." FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:CapabilityBadge State="{Binding SelectedGame.RayReconState}" Label="{Binding SelectedGame.Profile.RayDetailsStatusText}" Margin="0,0,12,0" />
                                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsEnabled="{Binding SelectedGame.CanToggleRayRecon}" IsChecked="{Binding SelectedGame.EnableRayReconstruction}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Hardware Compatibility & Recovery -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource LumaCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="System compatibility" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding SelectedGame.FriendlyStatusText}" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding GpuInfo.ModelName, StringFormat=Tailored for {0}}" FontFamily="{StaticResource FontUi}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                                <TextBlock Text="{Binding SelectedGame.Profile.PresetSummary}" FontFamily="{StaticResource FontUi}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LumaCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Installation &amp; recovery" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding SelectedGame.InstalledStatusText}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Original game files are always backed up before any change." FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Verify Files" Style="{StaticResource LumaSecondaryButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="16,0" Margin="0,0,8,4" Command="{Binding VerifyGameHealthCommand}" />
                                    <Button Content="Restore Original" Style="{StaticResource LumaDangerButtonStyle}" Height="{StaticResource ButtonHeightCompact}" Padding="16,0" Margin="0,0,0,4" Command="{Binding UninstallGameIntegrationCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Progressive Disclosure: Advanced Settings (Collapsed by Default) -->
                <Expander Header="Advanced settings (for enthusiasts)" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" IsExpanded="False">
                    <Border Style="{StaticResource LumaCardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Technical pipeline parameters" FontFamily="{StaticResource FontDisplay}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="Upscaler Engine" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Style="{StaticResource LumaComboBoxStyle}" ItemsSource="{Binding AvailableUpscalerEngines}" SelectedItem="{Binding SelectedGame.SelectedUpscalerEngine}" Margin="0,4,0,12" />

                                <TextBlock Text="Resolution Quality Preset" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Style="{StaticResource LumaComboBoxStyle}" ItemsSource="{Binding AvailableUpscalingPresets}" SelectedItem="{Binding SelectedGame.SelectedUpscalingPreset}" Margin="0,4,0,12" />

                                <TextBlock Text="Frame Generation Backend" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Style="{StaticResource LumaComboBoxStyle}" ItemsSource="{Binding AvailableFrameGenEngines}" SelectedItem="{Binding SelectedGame.SelectedFrameGenEngine}" Margin="0,4,0,12" />

                                <TextBlock Text="Proxy DLL Injection Target" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Style="{StaticResource LumaComboBoxStyle}" ItemsSource="{Binding AvailableProxyDllNames}" SelectedItem="{Binding SelectedGame.ProxyDllName}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Executable &amp; component diagnostics" FontFamily="{StaticResource FontDisplay}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding SelectedGame.Game.ExecutablePath, StringFormat=Executable: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedGame.NativeUpscalersSummary, StringFormat=Native Game Features: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedGame.Profile.NeuralRenderingReason, StringFormat=AI Rendering Note: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedGame.Profile.FrameGenerationReason, StringFormat=Frame Gen Note: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedGame.Profile.RayReconstructionReason, StringFormat=Ray Reconstruction Note: {0}}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding SelectedGame.ShowFsr4Watermark}" Content="Show FSR 4 Verification Watermark in game" Margin="0,0,0,8" />
                                <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding SelectedGame.EnableHudFix}" Content="Enable HUD anti-ghosting fix for Frame Generation" Margin="0,0,0,8" />
                                <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding SelectedGame.EnableAntiLag2}" Content="Enable Anti-Lag 2 latency reduction" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>