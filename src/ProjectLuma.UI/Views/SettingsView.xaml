<UserControl x:Class="ProjectLuma.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource PageGutter}">
            <Grid Margin="{StaticResource HeaderGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Settings" FontFamily="{StaticResource FontDisplay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Manage startup preferences, launch notifications, game folders, updates, and backup recovery."
                               FontFamily="{StaticResource FontUi}" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Replay Welcome Guide" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ShowOnboardingAgainCommand}" Margin="0,0,12,0" />
                    <Button Content="Save Preferences" Style="{StaticResource LumaPrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Balanced 2x2 Setting Grid -->
            <Grid Margin="{StaticResource SectionGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. General -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LumaCardStyle}">
                    <StackPanel>
                        <TextBlock Text="General" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.LaunchOnWindowsStartup}" Content="Start Project Luma with Windows" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding WindowsStartupStatusText}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.MinimizeToTray}" Content="Minimize to tray when closing main window" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.ShowInGameNotification}" Content="Show subtle Project Luma launch notification when starting a game" />
                    </StackPanel>
                </Border>

                <!-- 2. Updates -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource LumaCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Updates" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.AutoCheckUpdates}" Content="Automatically check for Project Luma updates" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.AutoDownloadVerifiedUpdates}" Content="Automatically download verified enhancement updates" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.AutoUpdateGameIntegrations}" Content="Automatically keep enhanced games up to date" Margin="0,0,0,12" />
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding UseExperimentalChannel}" Content="Include experimental preview builds" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Game Library & Artwork -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource LumaCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Game Library" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.EnableRemoteArtworkLookup}" Content="Automatically fetch missing game cover &amp; hero artwork online" Margin="0,0,0,12" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Refresh Artwork" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding RefreshArtworkCommand}" Height="{StaticResource ButtonHeightCompact}" Margin="0,0,8,4" />
                            <Button Content="Clear Artwork Cache" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ClearArtworkCacheCommand}" Height="{StaticResource ButtonHeightCompact}" Margin="0,0,0,4" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Additional Game Folders" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="Add Folder" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" Padding="12,0" HorizontalAlignment="Right" Command="{Binding AddCustomLibraryFolderCommand}" />
                        </Grid>

                        <TextBlock Text="Steam, Epic, GOG, Ubisoft, EA, Battle.net, and Xbox libraries are scanned automatically."
                                   Visibility="{Binding CustomLibraryPaths.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                   FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding CustomLibraryPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Content="Remove" Style="{StaticResource LumaDangerButtonStyle}" Height="24" Padding="8,0" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.RemoveLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 4. Recovery & Backups -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource LumaCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recovery" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                        <CheckBox Style="{StaticResource LumaToggleSwitchStyle}" IsChecked="{Binding Settings.PreserveBackupsOnUninstall}" Content="Preserve game backup recovery points if Project Luma is uninstalled" Margin="0,0,0,16" />
                        <TextBlock Text="Recovery Backup Vault Location" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Settings.BackupRootPath}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,16" />

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Open Backups Folder" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding OpenBackupFolderCommand}" Height="{StaticResource ButtonHeightCompact}" Margin="0,0,8,4" />
                            <Button Content="Export Diagnostics" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ExportHardwareProfileCommand}" Height="{StaticResource ButtonHeightCompact}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- About Project Luma Card (Supplied Ghost Emblem + Version + Font Notice) -->
            <Border Style="{StaticResource LumaCardStyle}" Margin="{StaticResource SectionGap}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{StaticResource LumaLogoDrawingImage}" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="PROJECT LUMA — GAMING ENHANCEMENT" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                            <Run Text="Version v" /><Run Text="{Binding Settings.AppVersion, Mode=OneWay}" /><Run Text="  |  Google Sans &amp; Space Mono (SIL OFL-1.1)" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Collapsible Advanced Diagnostics -->
            <Expander Header="Advanced diagnostics, GPU target &amp; logs" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" IsExpanded="False">
                <Border Style="{StaticResource LumaCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Detected GPU &amp; Compute Diagnostics" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                    <Run Text="{Binding GpuInfo.ModelName, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding GpuInfo.Architecture, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding GpuInfo.GpuTarget, Mode=OneWay}" />
                                    <Run Text=")  Adrenalin " />
                                    <Run Text="{Binding GpuInfo.AdrenalinVersionDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding HardwareProfile.HipRuntime, StringFormat=HIP Runtime: {0}}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding GpuInfo.HipInitDiagnostic}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Scan Game Folders for DLLs" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding ScanGameLibrariesForDllsCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Optional SteamGridDB API v2 Key (encrypted locally via Windows DPAPI)" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource LumaTextBoxStyle}" Text="{Binding SteamGridDbKeyInput}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Save API Key" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding SaveSteamGridDbKeyCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Structured Diagnostic Log" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="Open Logs Folder" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" HorizontalAlignment="Right" Command="{Binding OpenLogsFolderCommand}" />
                        </Grid>
                        <Border Background="{StaticResource SurfaceInputBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="12" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap">
                                                <Run Text="{Binding TimestampUtc, StringFormat=[{0:HH:mm:ss}] }" Foreground="#828282" />
                                                <Run Text="{Binding Category, StringFormat=[{0}] }" Foreground="#ED1C24" />
                                                <Run Text="{Binding Message}" Foreground="#F6F6F6" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>