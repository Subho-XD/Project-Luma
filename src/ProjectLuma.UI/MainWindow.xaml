<Window x:Class="ProjectLuma.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectLuma.UI.Views"
        Title="Project Luma — AMD Gaming Enhancement"
        Icon="pack://application:,,,/ProjectLuma.UI;component/Assets/Branding/project-luma-icon.png"
        Width="1360" Height="860"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource SurfaceCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="{StaticResource NavItemMargin}" />
            <Setter Property="Padding" Value="{StaticResource NavItemPadding}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource LumaFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveBar" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentOpticalBrush}" Margin="-10,0,8,0" Visibility="Collapsed" />
                                <Path Grid.Column="1" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderEmphasisBrush}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Quiet Left Navigation Sidebar (Exact Reference Hierarchy) -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceSidebarBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,16,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource LumaLogoDrawingImage}" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PROJECT LUMA" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="GAMING ENHANCEMENT" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Subtle Compact Hardware + Library Footer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding GpuInfo.ModelName}" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GpuInfo.GpuTarget}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ReadyGamesCount, StringFormat={}{0} game(s) ready}" FontFamily="{StaticResource FontUi}" FontSize="11.5" Foreground="{StaticResource StatusSupportedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 5 Primary Navigation Items (Home, My Games, Enhancement Library, Downloads, Settings) -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconHome}" Content="Home"
                                 IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Home" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconLibrary}" Content="My Games"
                                 IsChecked="{Binding IsMyGamesActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="MyGames" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconEnhancement}" Content="Enhancement Library"
                                 IsChecked="{Binding IsEnhancementLibraryActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="EnhancementLibrary" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconUpdates}" Content="Downloads"
                                 IsChecked="{Binding IsDownloadsActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Downloads" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Tag="{StaticResource IconSettings}" Content="Settings"
                                 IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>

                <!-- Quiet Quick Game Jump Rail (Zero uppercase eyebrows or decorative dots) -->
                <Grid Margin="0,16,0,8" Visibility="{Binding AllGames.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Margin="20,0,20,8" Padding="0,12,0,0">
                        <TextBlock Text="Recent games" FontFamily="{StaticResource FontUi}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AllGames}" Margin="12,0,12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenGameDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" Margin="0,0,0,4" Padding="0" Background="Transparent" BorderThickness="0"
                                            FocusVisualStyle="{StaticResource LumaFocusVisual}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="GamePill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusBadge}" Background="{StaticResource SurfaceInputBrush}" ClipToBounds="True" Margin="0,0,10,0">
                                                            <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToBitmapConverter}, ConverterParameter=64}"
                                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="Medium"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FriendlyStatusText}" FontFamily="{StaticResource FontUi}" FontSize="11"
                                                                       Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GamePill" Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                                                        <Setter TargetName="GamePill" Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main Workspace Content (No right-hand social column — expands cleanly) -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceCanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Persistent Action-Required Alert Banner -->
            <Border Grid.Row="0" MaxWidth="{StaticResource ContentMaxWidth}" Margin="32,16,32,0" Padding="16,12" CornerRadius="{StaticResource RadiusButton}" BorderThickness="1"
                    Visibility="{Binding ActionAlertMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource StatusUnsupportedBgBrush}"
                    BorderBrush="{StaticResource StatusUnsupportedBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ActionAlertMessage}" FontFamily="{StaticResource FontUi}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Close" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" Padding="12,0" Command="{Binding DismissAlertCommand}" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- Active Page Content -->
            <Grid Grid.Row="1">
                <views:HomeView Visibility="{Binding IsHomeActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:GameLibraryView Visibility="{Binding IsMyGamesActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:GameDetailsView Visibility="{Binding IsGameDetailsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:EnhancementCentreView Visibility="{Binding IsEnhancementLibraryActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:UpdateCentreView Visibility="{Binding IsDownloadsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:SettingsView Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Auto-Dismissing Routine Toast Notification (3.5s) -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#F2181818" BorderBrush="{StaticResource StatusSupportedBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="16,12" MaxWidth="460">
                <TextBlock Text="{Binding ToastMessage}" FontFamily="{StaticResource FontUi}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- Guided Setup Modal (No uppercase eyebrow, clean 4pt padding) -->
            <Grid Grid.RowSpan="2" Background="#CC080808" Visibility="{Binding IsSetupDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource DialogPadding}">
                    <StackPanel>
                        <TextBlock Text="{Binding SetupDrawerHeader}" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentOpticalBrush}" />
                        <TextBlock Text="{Binding SelectedGame.Title}" FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,16" />

                        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SetupSteps}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource FontUi}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding Detail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding StateDisplay}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{Binding State, Converter={StaticResource SetupStepBrushConverter}}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Discovered local NVIDIA Neural Rendering DLL candidates -->
                                <Border Visibility="{Binding DiscoveredSetupCandidates.Count, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{StaticResource SurfaceWellBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Discovered Local Component Files" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding DiscoveredSetupCandidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding DisplaySummary}" FontFamily="{StaticResource FontUi}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SourcePath}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Use This File" Style="{StaticResource LumaSecondaryButtonStyle}" Height="28" FontSize="11.5" Padding="10,0"
                                                                IsEnabled="{Binding CanImport}"
                                                                Command="{Binding DataContext.UseDiscoveredNeuralCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="Please keep Project Luma open while setup completes." FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsSetupRunning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12" />

                        <Border Visibility="{Binding SetupErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{StaticResource StatusUnsupportedBgBrush}" BorderBrush="{StaticResource StatusUnsupportedBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusButton}" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SetupErrorMessage}" FontFamily="{StaticResource FontUi}" FontSize="12.5" Foreground="#F28B8B" TextWrapping="Wrap" />
                        </Border>

                        <Grid>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                       Visibility="{Binding IsAiVisualsSetupDrawer, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="Import NVIDIA DLL" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" FontSize="12" Padding="12,0" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsSetupRunning, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding ImportNvidiaDllCommand}" />
                                <Button Content="Open DLL Vault" Style="{StaticResource LumaSecondaryButtonStyle}" Height="32" FontSize="12" Padding="12,0" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsSetupRunning, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding OpenDllVaultCommand}" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource LumaDangerButtonStyle}" Command="{Binding CancelSetupCommand}"
                                        Visibility="{Binding IsSetupRunning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,8,0" />
                                <Button Content="Done" Style="{StaticResource LumaPrimaryButtonStyle}" Command="{Binding CloseSetupDrawerCommand}"
                                        Visibility="{Binding IsSetupRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Simplified 3-Step First-Run Onboarding (Game Hub Visual Language) -->
            <Grid Grid.RowSpan="2" Background="#D8080808" Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderEmphasisBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusHero}" Padding="32">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource LumaLogoDrawingImage}" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PROJECT LUMA" FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="GAMING ENHANCEMENT" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding OnboardingStepIndex, StringFormat=Step {0} of 3}" FontFamily="{StaticResource FontUi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentOpticalBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding OnboardingTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding OnboardingDescription}" FontFamily="{StaticResource FontUi}" FontSize="14" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                        <Button Content="Add Game Folder" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding AddCustomLibraryFolderCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,16"
                                Visibility="{Binding IsOnboardingStep2, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ProgressBar Value="{Binding OnboardingStepIndex}" Minimum="0" Maximum="3" Height="6" Foreground="{StaticResource AccentOpticalBrush}" Background="{StaticResource SurfaceSecondaryBrush}" BorderThickness="0" Margin="0,0,0,24" />

                        <Grid>
                            <Button Content="Skip" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding SkipOnboardingCommand}" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Open Recommended Game" Style="{StaticResource LumaSecondaryButtonStyle}" Command="{Binding OpenRecommendedGameFromOnboardingCommand}"
                                        Visibility="{Binding IsOnboardingStep3, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,8,0" />
                                <Button Content="{Binding OnboardingPrimaryButtonText}" Style="{StaticResource LumaPrimaryButtonStyle}" Command="{Binding NextOnboardingCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
