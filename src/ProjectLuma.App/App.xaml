<Application x:Class="ProjectLuma.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProjectLuma.UI.Converters;assembly=ProjectLuma.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProjectLuma.UI;component/Themes/LumaTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ProjectLuma.UI;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:CapabilityStateBrushConverter x:Key="CapabilityStateBrushConverter" />
            <conv:FriendlyStatusBrushConverter x:Key="FriendlyStatusBrushConverter" />
            <conv:SetupStepBrushConverter x:Key="SetupStepBrushConverter" />
            <conv:CapabilityStateLabelConverter x:Key="CapabilityStateLabelConverter" />
            <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <conv:StringEqualsMultiConverter x:Key="StringEqualsMultiConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:ObjectReferenceEqualsMultiConverter x:Key="ObjectReferenceEqualsMultiConverter" />
            <conv:ComponentStateBrushConverter x:Key="ComponentStateBrushConverter" />
            <conv:NeuralActivationBrushConverter x:Key="NeuralActivationBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
